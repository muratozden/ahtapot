{
  "name": "ahtapot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @ahtapot/web",
    "build:web": "npm run build -w @ahtapot/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "npm run generate -w @ahtapot/db",
    "db:migrate": "npm run migrate -w @ahtapot/db",
    "db:import-categories": "node --env-file=.env packages/db/scripts/import-categories.mts",
    "db:bulk-set-marketplace-fees": "node --env-file=.env packages/db/scripts/bulk-set-marketplace-fees.mts",
    "deploy": "bash scripts/deploy.sh"
  }
}
